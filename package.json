{
  "name": "paperpack",
  "version": "0.0.0",
  "description": "Answer a set of questions, get the worked-out figures back with their sources",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "node scripts/check.mjs",
    "e2e": "tsc && node scripts/e2e.mjs",
    "bundle": "tsc && node scripts/bundle.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "tsc && node --test $(find dist scripts -name '*.test.*js')"
  },
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "packs"
  ],
  "packageManager": "pnpm@10.33.0"
}
